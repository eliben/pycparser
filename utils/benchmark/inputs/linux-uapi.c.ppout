# 2224 "headers/include/linux/ethtool.h"
static inline int ethtool_validate_speed(__u32 speed)
{
 return speed <= ((int)(~0U >> 1)) || speed == (__u32)-1;
}






static inline int ethtool_validate_duplex(__u8 duplex)
{
 switch (duplex) {
 case 0x00:
 case 0x01:
 case 0xff:
  return 1;
 }

 return 0;
}
